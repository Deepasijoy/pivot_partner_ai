GROQ_API_KEY=
ADZUNA_APP_ID=
ADZUNA_API_KEY=
# Optional — the multi-provider job aggregator's JSearch adapter degrades
# gracefully (reports "not configured") when this is unset. Not required
# for Adzuna or any other existing functionality.
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
# Himalayas requires no API key at all — no variable to set here. Its
# route (GET /api/jobs/himalayas) is always available; see the rate-limit
# and timeout overrides below.
PORT=3000

# The frontend origin CORS should allow. Defaults to the local Vite dev
# server (http://localhost:5173) when unset — set this to the deployed
# frontend's own URL in production (e.g. a Render static site's origin).
FRONTEND_URL=http://localhost:5173

# Optional — override the default per-route rate limits (requests per
# window, per IP). /api/chat defaults to 20 requests / 60s (it calls Groq,
# the most expensive metered call in the app, but still needs headroom for
# a real back-and-forth conversation); /api/jobs and /api/jobs/jsearch each
# default to 30 requests / 60s.
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_RATE_LIMIT_MAX=20
# JOBS_RATE_LIMIT_WINDOW_MS=60000
# JOBS_RATE_LIMIT_MAX=30
# JSEARCH_RATE_LIMIT_WINDOW_MS=60000
# JSEARCH_RATE_LIMIT_MAX=30
# HIMALAYAS_RATE_LIMIT_WINDOW_MS=60000
# HIMALAYAS_RATE_LIMIT_MAX=30

# Optional — override the default outbound-fetch timeouts (ms) for this
# server's own calls to third-party APIs. Each gets one bounded retry on a
# transient failure (network error or 5xx) — see server/fetchWithRetry.js.
# ADZUNA_FETCH_TIMEOUT_MS=10000
# JSEARCH_FETCH_TIMEOUT_MS=10000
# HIMALAYAS_FETCH_TIMEOUT_MS=10000
# GROQ_FETCH_TIMEOUT_MS=20000

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional — override the default timeouts (ms) for the frontend's own
# fetch calls. VITE_JOB_FETCH_TIMEOUT_MS applies to every job-provider call
# (Adzuna/Arbeitnow/Remotive/JSearch); VITE_CHAT_FETCH_TIMEOUT_MS applies to
# the AI chat call, which is given more headroom since a real LLM
# completion can take longer than a job search. Each gets one bounded retry
# on a transient failure — see src/utils/fetchWithRetry.ts.
# VITE_JOB_FETCH_TIMEOUT_MS=10000
# VITE_CHAT_FETCH_TIMEOUT_MS=20000
